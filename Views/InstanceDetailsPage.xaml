<Page x:Class="FluentLauncher.Views.InstanceDetailsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:core="clr-namespace:FluentLauncher.Core"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      mc:Ignorable="d" 
      d:DesignHeight="600" d:DesignWidth="800"
      xmlns:markdig="clr-namespace:Markdig.Wpf;assembly=Markdig.Wpf"
      Title="InstanceDetailsPage" TextElement.Foreground="{DynamicResource TextFillColorPrimaryBrush}">

    <Grid x:Name="RootGrid">
        <Grid.Resources>
            <BooleanToVisibilityConverter x:Key="BoolToVis" />
            <core:ImagePathConverter x:Key="ImgConv" />
        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <ui:Button Grid.Column="0" Icon="{ui:SymbolIcon ArrowLeft24}" Appearance="Transparent" Command="{Binding ViewModel.GoBackCommand}" Margin="0,0,16,0" VerticalAlignment="Center"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Border Width="48" Height="48" CornerRadius="8" Background="{DynamicResource ControlFillColorDefaultBrush}" Margin="0,0,16,0" ClipToBounds="True">
                    <Grid>
                        <ui:SymbolIcon Symbol="Cube24" FontSize="24" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        <Image Source="{Binding ViewModel.CurrentInstance.IconPath, Converter={StaticResource ImgConv}}" Stretch="UniformToFill" />
                    </Grid>
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding ViewModel.CurrentInstance.Name}" FontSize="24" FontWeight="SemiBold"/>
                    <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                        <Run Text="{Binding ViewModel.CurrentInstance.MinecraftVersion}" />
                        <Run Text=" • " />
                        <Run Text="{Binding ViewModel.CurrentInstance.ModLoader}" />
                    </TextBlock>
                </StackPanel>
            </StackPanel>

            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <ui:Button Content="Open Folder" Icon="{ui:SymbolIcon Folder24}" Command="{Binding ViewModel.OpenFolderCommand}" Margin="0,0,8,0" />
                <ui:Button Content="Install Files" Icon="{ui:SymbolIcon ArrowDownload24}" Command="{Binding ViewModel.InstallGameFilesCommand}" Margin="0,0,8,0" />
                <ui:Button Command="{Binding ViewModel.PlayInstanceCommand}">
                    <ui:Button.Style>
                        <Style TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
                            <Setter Property="Content" Value="Play" />
                            <Setter Property="Appearance" Value="Primary" />
                            <Setter Property="Icon" Value="{ui:SymbolIcon Play24}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ViewModel.CurrentInstance.IsRunning}" Value="True">
                                    <Setter Property="Content" Value="Close" />
                                    <Setter Property="Appearance" Value="Danger" />
                                    <Setter Property="Icon" Value="{ui:SymbolIcon Stop24}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ui:Button.Style>
                </ui:Button>
            </StackPanel>
        </Grid>

        <!-- Content -->
        <!-- Content -->
        <TabControl Grid.Row="1" Margin="24,0,24,24" Background="Transparent" BorderThickness="0" SelectedIndex="{Binding ViewModel.SelectedTabIndex}">
            <TabItem Header="Installed">
                <Grid Margin="0,16,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,16">
                        <ComboBox SelectedValuePath="Tag" SelectedValue="{Binding ViewModel.InstalledFilterMode, UpdateSourceTrigger=PropertyChanged}" Width="200" Margin="0,0,8,0">
                            <ComboBoxItem Content="Mods" Tag="mod"/>
                            <ComboBoxItem Content="Resource Packs" Tag="resourcepack"/>
                            <ComboBoxItem Content="Shaders" Tag="shader"/>
                        </ComboBox>
                        <ui:Button Content="Install .jar" Icon="{ui:SymbolIcon Add24}" Command="{Binding ViewModel.InstallJarCommand}" />
                    </StackPanel>
                    <ListBox Grid.Row="1" ItemsSource="{Binding ViewModel.InstalledFiles}" BorderThickness="0" Background="Transparent" HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Focusable" Value="False"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Margin" Value="0"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <ContentPresenter />
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="64"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="100"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Width="48" Height="48" CornerRadius="4" ClipToBounds="True" Background="{DynamicResource ControlFillColorDefaultBrush}">
                                            <Grid>
                                                <!-- Placeholder if no icon -->
                                                <ui:SymbolIcon Symbol="Code24" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                                <Image Source="{Binding IconUrl}" Stretch="UniformToFill"/>
                                            </Grid>
                                        </Border>
                                        <TextBlock Grid.Column="1" Text="{Binding DisplayName}" FontWeight="SemiBold" FontSize="16" Foreground="{DynamicResource TextFillColorPrimaryBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                        <ui:Button Grid.Column="2" Content="Delete" Appearance="Danger" Command="{Binding DataContext.ViewModel.DeleteInstalledFileCommand, RelativeSource={RelativeSource AncestorType=Page}}" CommandParameter="{Binding FileName}" VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </TabItem>

            <TabItem Header="Add">
                <Grid Margin="0,16,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ComboBox Grid.Column="0" SelectedValuePath="Tag" SelectedValue="{Binding ViewModel.AddFilterMode, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,0" Width="150">
                            <ComboBoxItem Content="Mods" Tag="mod"/>
                            <ComboBoxItem Content="Resource Packs" Tag="resourcepack"/>
                            <ComboBoxItem Content="Shaders" Tag="shader"/>
                        </ComboBox>
                        <ComboBox Grid.Column="1" SelectedValuePath="Tag" SelectedValue="{Binding ViewModel.AddSortMode, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,0" Width="150">
                            <ComboBoxItem Content="Relevance" Tag="relevance"/>
                            <ComboBoxItem Content="Downloads" Tag="downloads"/>
                            <ComboBoxItem Content="Follows" Tag="follows"/>
                            <ComboBoxItem Content="Newest" Tag="newest"/>
                        </ComboBox>
                        <ui:TextBox Grid.Column="2" Text="{Binding ViewModel.ModSearchQuery, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Search..." Margin="0,0,8,0">
                            <ui:TextBox.InputBindings>
                                <KeyBinding Key="Enter" Command="{Binding ViewModel.SearchModsCommand}" />
                            </ui:TextBox.InputBindings>
                        </ui:TextBox>
                        <ui:Button Grid.Column="3" Content="Search" Appearance="Primary" Command="{Binding ViewModel.SearchModsCommand}"/>
                    </Grid>

                    <ListBox Grid.Row="1" ItemsSource="{Binding ViewModel.ModSearchResults}" BorderThickness="0" Background="Transparent" HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.ScrollChanged="ModSearchListBox_ScrollChanged">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Focusable" Value="False"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Margin" Value="0"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <ContentPresenter />
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <ui:CardAction Command="{Binding DataContext.ViewModel.OpenModDetailsCommand, RelativeSource={RelativeSource AncestorType=Page}}" CommandParameter="{Binding}" Margin="0,0,0,8" Padding="16">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="64"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="100"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Width="48" Height="48" CornerRadius="4" ClipToBounds="True" Background="{DynamicResource ControlFillColorDefaultBrush}">
                                            <Image Source="{Binding IconUrl}" Stretch="UniformToFill"/>
                                        </Border>
                                        <StackPanel Grid.Column="1" Margin="16,0,16,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="16" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                            <TextBlock Text="{Binding Description}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" MaxHeight="40" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding Author, StringFormat='By {0}'}" FontSize="12" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Margin="0,4,0,0"/>
                                        </StackPanel>
                                        <ui:Button Grid.Column="2" Command="{Binding DataContext.ViewModel.InstallModCommand, RelativeSource={RelativeSource AncestorType=Page}}" CommandParameter="{Binding}" VerticalAlignment="Center" HorizontalAlignment="Right" Width="80">
                                            <ui:Button.Style>
                                                <Style TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
                                                    <Setter Property="Content" Value="Install" />
                                                    <Setter Property="Appearance" Value="Secondary" />
                                                    <Setter Property="IsEnabled" Value="True" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsInstalled}" Value="True">
                                                            <Setter Property="Content" Value="Installed" />
                                                            <Setter Property="IsEnabled" Value="False" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </ui:Button.Style>
                                        </ui:Button>
                                    </Grid>
                                </ui:CardAction>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </TabItem>
            
            <TabItem Header="Settings">
                <Grid Margin="0,16,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0">
                        <TextBlock Text="Instance Name" FontWeight="SemiBold" Margin="0,0,0,8" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                        <ui:TextBox Text="{Binding ViewModel.CurrentInstance.Name, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,16" />

                        <TextBlock Text="Instance Icon" FontWeight="SemiBold" Margin="0,0,0,8" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,24">
                            <Border Width="64" Height="64" CornerRadius="8" Background="{DynamicResource ControlFillColorDefaultBrush}" Margin="0,0,16,0" ClipToBounds="True">
                                <Grid>
                                    <ui:SymbolIcon Symbol="Image24" FontSize="24" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    <Image Source="{Binding ViewModel.CurrentInstance.IconPath, Converter={StaticResource ImgConv}}" Stretch="UniformToFill">
                                        <Image.Style>
                                            <Style TargetType="Image">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding ViewModel.CurrentInstance.HasIcon}" Value="False">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Image.Style>
                                    </Image>
                                </Grid>
                            </Border>
                            <ui:Button Content="Change Icon" Command="{Binding ViewModel.ChangeInstanceIconCommand}" VerticalAlignment="Center"/>
                        </StackPanel>
                        
                        <TextBlock Text="Allocated RAM (MB)" FontWeight="SemiBold" Margin="0,0,0,8" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                        <Slider Minimum="1024" Maximum="16384" Value="{Binding ViewModel.CurrentInstance.AllocatedRam, UpdateSourceTrigger=PropertyChanged}" TickFrequency="1024" IsSnapToTickEnabled="True" Margin="0,0,0,8"/>
                        <TextBlock Text="{Binding ViewModel.CurrentInstance.AllocatedRam, StringFormat='{}{0} MB'}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,16"/>
                        
                        <TextBlock Text="Java Path (Leave empty for system default)" FontWeight="SemiBold" Margin="0,0,0,8" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ui:TextBox Text="{Binding ViewModel.CurrentInstance.JavaPath, UpdateSourceTrigger=PropertyChanged}" />
                            <ui:Button Grid.Column="1" Content="Browse..." Command="{Binding ViewModel.BrowseJavaCommand}" Margin="8,0,0,0"/>
                        </Grid>
                    </StackPanel>
                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
                        <ui:Button Content="Export FLPack (.flpack)" Appearance="Primary" Icon="{ui:SymbolIcon ArrowExport24}" Command="{Binding ViewModel.OpenExportDialogCommand}" Margin="0,0,16,0" />
                        <ui:Button Content="Delete Instance" Appearance="Danger" Icon="{ui:SymbolIcon Delete24}" Command="{Binding ViewModel.DeleteInstanceCommand}" />
                    </StackPanel>
                </Grid>
            </TabItem>
            <TabItem Header="Logs">
                <Grid Margin="0,16,0,0">
                    <TextBox Text="{Binding ViewModel.CurrentInstance.InstanceLogs}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Background="#111" Foreground="#eee" FontFamily="Consolas" BorderThickness="0" Padding="8" VerticalAlignment="Stretch" HorizontalAlignment="Stretch" />
                </Grid>
            </TabItem>
        </TabControl>

        <!-- Export Dialog Overlay -->
        <Border Grid.RowSpan="2" Panel.ZIndex="105" Background="{DynamicResource ApplicationBackgroundBrush}" Opacity="0.8" Visibility="{Binding ViewModel.IsExportDialogOpen, Converter={StaticResource BoolToVis}}" />
        <Border Grid.RowSpan="2" Panel.ZIndex="106" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                Visibility="{Binding ViewModel.IsExportDialogOpen, Converter={StaticResource BoolToVis}}" 
                VerticalAlignment="Center" HorizontalAlignment="Center" CornerRadius="8" Padding="24" Width="550">
            <StackPanel>
                <TextBlock Text="Export FLPack" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,0,0,16"/>
                
                <TextBlock Text="Pack Name:" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,4"/>
                <ui:TextBox Text="{Binding ViewModel.ExportPackName, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,16" />
                
                <TextBlock Text="Select files to include:" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,8"/>
                <ListBox ItemsSource="{Binding ViewModel.ExportFiles}" MaxHeight="350" Background="Transparent" BorderThickness="0" ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="4,0" />
                            <Setter Property="MinHeight" Value="24" />
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <CheckBox Content="{Binding Name}" IsChecked="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" Margin="0" Padding="8,0,0,0" MinHeight="20" VerticalAlignment="Center" />
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                    <ui:Button Content="Cancel" Command="{Binding ViewModel.CloseExportDialogCommand}" Margin="0,0,8,0" />
                    <ui:Button Content="Export" Appearance="Primary" Command="{Binding ViewModel.ConfirmExportCommand}" />
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Overlay for regular work (mods, exports) -->
        <Border Grid.RowSpan="2" Panel.ZIndex="100" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                Visibility="{Binding ViewModel.IsWorking, Converter={StaticResource BoolToVis}}" 
                VerticalAlignment="Bottom" Margin="0,0,0,24" CornerRadius="8" Padding="24" MaxWidth="600" HorizontalAlignment="Stretch">
            <StackPanel>
                <TextBlock Text="{Binding ViewModel.WorkStatus}" Foreground="{DynamicResource TextFillColorPrimaryBrush}" FontWeight="SemiBold" Margin="0,0,0,12" TextWrapping="Wrap" />
                <ProgressBar Value="{Binding ViewModel.WorkProgress}" IsIndeterminate="False" Height="4" />
            </StackPanel>
        </Border>

        <!-- Overlay for game launch state -->
        <Border Grid.RowSpan="2" Panel.ZIndex="101" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                Visibility="{Binding ViewModel.CurrentInstance.IsRunning, Converter={StaticResource BoolToVis}}" 
                VerticalAlignment="Bottom" Margin="0,0,0,100" CornerRadius="8" Padding="24" MaxWidth="600" HorizontalAlignment="Stretch">
            <StackPanel>
                <TextBlock Text="{Binding ViewModel.CurrentInstance.LaunchStatus}" Foreground="{DynamicResource TextFillColorPrimaryBrush}" FontWeight="SemiBold" Margin="0,0,0,12" TextWrapping="Wrap" />
                <ProgressBar Value="{Binding ViewModel.CurrentInstance.LaunchProgress}" IsIndeterminate="False" Height="4" />
            </StackPanel>
        </Border>

        <!-- Mod Details Background Overlay -->
        <Grid Grid.RowSpan="2" Panel.ZIndex="200" Background="#80000000" Visibility="{Binding ViewModel.IsModDetailsOpen, Converter={StaticResource BoolToVis}}">
        </Grid>

        <!-- Mod Details Popup -->
        <Popup IsOpen="{Binding ViewModel.IsModDetailsOpen}" Placement="Center" PlacementTarget="{Binding ElementName=RootGrid}" AllowsTransparency="True">
            <Border MaxWidth="800" MaxHeight="600" Background="{DynamicResource ApplicationBackgroundBrush}" CornerRadius="12" Padding="24" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                        <Border Width="64" Height="64" CornerRadius="8" ClipToBounds="True" Background="{DynamicResource ControlFillColorDefaultBrush}" Margin="0,0,16,0">
                            <Image Source="{Binding ViewModel.SelectedMod.IconUrl}" Stretch="UniformToFill"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{Binding ViewModel.SelectedMod.Title}" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                            <TextBlock Text="{Binding ViewModel.SelectedMod.Author, StringFormat='By {0}'}" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>
                    </StackPanel>
                    
                    <TabControl Grid.Row="1">
                        <TabItem Header="Description">
                            <markdig:MarkdownViewer Markdown="{Binding ViewModel.SelectedMod.Body}" Margin="8,16,8,16" Background="Transparent" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                        </TabItem>
                        <TabItem Header="Gallery">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <ItemsControl ItemsSource="{Binding ViewModel.SelectedMod.Gallery}" Margin="8,16,8,16" Background="Transparent" BorderThickness="0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border CornerRadius="8" ClipToBounds="True" Margin="0,0,0,16" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                                                <Image Source="{Binding Url}" Stretch="UniformToFill" MaxHeight="400"/>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </TabItem>
                    </TabControl>
                    
                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                        <ui:Button Content="Close" Command="{Binding ViewModel.CloseModDetailsCommand}" Margin="0,0,8,0"/>
                        <ui:Button Command="{Binding ViewModel.InstallModCommand}" CommandParameter="{Binding ViewModel.SelectedMod}">
                            <ui:Button.Style>
                                <Style TargetType="ui:Button" BasedOn="{StaticResource DefaultButtonStyle}">
                                    <Setter Property="Content" Value="Install"/>
                                    <Setter Property="Appearance" Value="Primary"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ViewModel.SelectedMod.IsInstalled}" Value="True">
                                            <Setter Property="Content" Value="Installed"/>
                                            <Setter Property="IsEnabled" Value="False"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ui:Button.Style>
                        </ui:Button>
                    </StackPanel>
                </Grid>
            </Border>
        </Popup>
    </Grid>
</Page>
