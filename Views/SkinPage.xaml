<Page x:Class="FluentLauncher.Views.SkinPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:FluentLauncher.Views"
      xmlns:converters="clr-namespace:FluentLauncher.Converters"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
      mc:Ignorable="d" 
      d:DesignHeight="750" d:DesignWidth="1000"
      Title="SkinPage" Foreground="{DynamicResource TextFillColorPrimaryBrush}">

    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <converters:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVis" />
    </Page.Resources>

    <Grid>
        <!-- Offline Message -->
        <TextBlock Text="{DynamicResource Str_OfflineSkinWarning}" 
                   FontSize="24" FontWeight="SemiBold" 
                   HorizontalAlignment="Center" VerticalAlignment="Center"
                   Foreground="{DynamicResource TextFillColorDisabledBrush}"
                   Visibility="{Binding ViewModel.IsOfflineAccount, Converter={StaticResource BoolToVis}}"/>

        <!-- Main Content for Online Accounts -->
        <Grid Visibility="{Binding ViewModel.IsOfflineAccount, Converter={StaticResource InverseBoolToVis}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="400"/>
            </Grid.ColumnDefinitions>

            <!-- 3D Skin Viewer -->
            <Border Grid.Column="0" Margin="0,0,24,0" Background="#1A000000" CornerRadius="8" ClipToBounds="True">
                <wv2:WebView2 x:Name="SkinWebView" />
            </Border>

            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Top Right: Upload Controls -->
                <StackPanel Grid.Row="0" Margin="0,0,0,24">
                    <TextBlock Text="{DynamicResource Str_SkinManagement}" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,16"/>
                    
                    <TextBlock Text="{DynamicResource Str_ModelType}" Margin="0,0,0,8" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                    <ComboBox SelectedValue="{Binding ViewModel.SelectedVariant, Mode=TwoWay}" SelectedValuePath="Tag" Margin="0,0,0,16" HorizontalAlignment="Stretch">
                        <ComboBoxItem Content="Steve (Classic)" Tag="classic" />
                        <ComboBoxItem Content="Alex (Slim)" Tag="slim" />
                    </ComboBox>

                    <ui:Button Content="{DynamicResource Str_UploadCustomSkin}" Icon="{ui:SymbolIcon ArrowUpload24}" 
                               Appearance="Primary" Command="{Binding ViewModel.UploadSkinCommand}" 
                               HorizontalAlignment="Stretch" Margin="0,0,0,16"/>

                    <!-- Status Message -->
                    <TextBlock Text="{Binding ViewModel.StatusMessage}" Foreground="{DynamicResource SystemFillColorSuccessBrush}" TextWrapping="Wrap"/>
                    <ProgressBar IsIndeterminate="True" Visibility="{Binding ViewModel.IsWorking, Converter={StaticResource BoolToVis}}" Margin="0,8,0,0"/>
                </StackPanel>

                <!-- Bottom Right: Predefined Skins -->
                <StackPanel Grid.Row="1">
                    <TextBlock Text="{DynamicResource Str_PredefinedSkins}" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,16"/>
                    <ListBox ItemsSource="{Binding ViewModel.ReadyMadeSkins}" Background="Transparent" BorderThickness="0" 
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="64"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    
                                    <Border Width="48" Height="48" CornerRadius="4" Background="{DynamicResource ControlFillColorDefaultBrush}" HorizontalAlignment="Left" ClipToBounds="True">
                                        <Image Source="{Binding PreviewImage}" Stretch="UniformToFill" />
                                    </Border>
                                    
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="16"/>
                                        <TextBlock Text="{Binding Variant}" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                    </StackPanel>

                                    <ui:Button Grid.Column="2" Content="{DynamicResource Str_Apply}" Command="{Binding DataContext.ViewModel.ApplyPredefinedSkinCommand, RelativeSource={RelativeSource AncestorType=Page}}" CommandParameter="{Binding}" VerticalAlignment="Center"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</Page>
