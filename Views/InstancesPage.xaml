<Page x:Class="FluentLauncher.Views.InstancesPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:local="clr-namespace:FluentLauncher.Views"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="InstancesPage" TextElement.Foreground="{DynamicResource TextFillColorPrimaryBrush}">

    <Grid Margin="24">
        <Grid.Resources>
            <BooleanToVisibilityConverter x:Key="BoolToVis" />
            <core:ImagePathConverter x:Key="ImgConv" xmlns:core="clr-namespace:FluentLauncher.Core" />
        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,24">
            <TextBlock Text="{DynamicResource Str_YourInstances}" FontSize="28" FontWeight="SemiBold" VerticalAlignment="Center"/>
            <ui:Button Content="{DynamicResource Str_CreateInstance}" Icon="{ui:SymbolIcon Add24}" Appearance="Primary" Command="{Binding ViewModel.CreateInstanceCommand}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
        </Grid>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Visibility="{Binding ViewModel.HasInstances, Converter={StaticResource BoolToVis}}">
            <ItemsControl ItemsSource="{Binding ViewModel.Instances}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border x:Name="CardBorder" Margin="0,0,16,16" Width="220" CornerRadius="8" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                            <Border.InputBindings>
                                <MouseBinding MouseAction="LeftClick" Command="{Binding DataContext.ViewModel.EditInstanceCommand, RelativeSource={RelativeSource AncestorType=Page}}" CommandParameter="{Binding}" />
                            </Border.InputBindings>
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorSecondaryBrush}" />
                                            <Setter Property="Cursor" Value="Hand" />
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="120" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                
                                <!-- Icon / Placeholder -->
                                <Border Grid.Row="0" CornerRadius="8,8,0,0" Background="{DynamicResource ControlFillColorDefaultBrush}" ClipToBounds="True">
                                    <Grid>
                                        <ui:SymbolIcon Symbol="Cube24" FontSize="64" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                        <Image Source="{Binding IconPath, Converter={StaticResource ImgConv}}" Stretch="UniformToFill" />
                                    </Grid>
                                </Border>

                                <!-- Details -->
                                <Border Grid.Row="1" Padding="12" Background="Transparent">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,8,0">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="16" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                            <TextBlock Text="{Binding MinecraftVersion}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12" Margin="0,4,0,0" />
                                            <TextBlock Text="{Binding ModLoader}" Foreground="{DynamicResource TextFillColorTertiaryBrush}" FontSize="12" />
                                        </StackPanel>
                                        <!-- Actions -->
                                        <ui:Button Grid.Column="1" Command="{Binding DataContext.ViewModel.PlayInstanceCommand, RelativeSource={RelativeSource AncestorType=Page}}" CommandParameter="{Binding}" VerticalAlignment="Center">
                                            <ui:Button.Style>
                                                <Style TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
                                                    <Setter Property="Content" Value="Play" />
                                                    <Setter Property="Appearance" Value="Primary" />
                                                    <Setter Property="Icon" Value="{ui:SymbolIcon Play24}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                                            <Setter Property="Content" Value="Close" />
                                                            <Setter Property="Appearance" Value="Danger" />
                                                            <Setter Property="Icon" Value="{ui:SymbolIcon Stop24}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </ui:Button.Style>
                                        </ui:Button>
                                    </Grid>
                                </Border>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- Edit Overlay removed as it moved to Details Page -->

        <!-- Empty State -->
        <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="{Binding ViewModel.IsEmpty, Converter={StaticResource BoolToVis}}">
            <ui:SymbolIcon Symbol="Cube24" FontSize="64" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,16" />
            <TextBlock Text="{DynamicResource Str_NoInstances}" FontSize="16" Foreground="{DynamicResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" Margin="0,0,0,24" />
            <ui:Button Content="{DynamicResource Str_CreateInstance}" Appearance="Primary" Command="{Binding ViewModel.CreateInstanceCommand}" HorizontalAlignment="Center" Padding="24,8" />
        </StackPanel>

        <!-- Launch Overlay -->
        <Border Grid.RowSpan="2" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                Visibility="{Binding ViewModel.IsLaunching, Converter={StaticResource BoolToVis}}" 
                VerticalAlignment="Bottom" Margin="0,0,0,24" CornerRadius="8" Padding="24" MaxWidth="600" HorizontalAlignment="Stretch">
            <StackPanel>
                <TextBlock Text="{Binding ViewModel.LaunchStatus}" Foreground="{DynamicResource TextFillColorPrimaryBrush}" FontWeight="SemiBold" Margin="0,0,0,12" TextWrapping="Wrap" />
                <ProgressBar Value="{Binding ViewModel.LaunchProgress}" IsIndeterminate="False" Height="4" />
            </StackPanel>
        </Border>
    </Grid>
</Page>
