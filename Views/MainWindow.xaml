<ui:FluentWindow x:Class="FluentLauncher.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:local="clr-namespace:FluentLauncher.Views"
        mc:Ignorable="d"
        Title="Fluent Launcher" Height="750" Width="1200"
        WindowBackdropType="Mica"
        ExtendsContentIntoTitleBar="True"
        WindowStartupLocation="CenterScreen"
        TextElement.Foreground="{DynamicResource TextFillColorPrimaryBrush}">
    
    <Grid>
        <ui:TitleBar x:Name="TitleBar" Title="Fluent Launcher" Margin="0,0,0,0">
            <ui:TitleBar.Icon>
                <ui:ImageIcon Source="/FluentLauncherIcon.ico" Width="16" Height="16" Margin="4,0,4,0" />
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <TextBlock Text="{DynamicResource Str_ByAuthor}" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,8" Foreground="{DynamicResource TextFillColorDisabledBrush}" FontSize="12" IsHitTestVisible="False" Panel.ZIndex="100"/>
        <TextBlock Text="{Binding ViewModel.AppVersion}" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,12,8" FontSize="12" Foreground="{DynamicResource TextFillColorDisabledBrush}" IsHitTestVisible="False" Panel.ZIndex="100"/>
        
        <ui:NavigationView
            x:Name="RootNavigation"
            Margin="0,32,0,0"
            PaneDisplayMode="Top"
            IsBackButtonVisible="Collapsed">
            <ui:NavigationView.MenuItems>
                <ui:NavigationViewItem Content="{DynamicResource Str_Instances}" TargetPageType="{x:Type local:InstancesPage}" Icon="{ui:SymbolIcon Cube24}" />
                <ui:NavigationViewItem Content="{DynamicResource Str_Skin}" TargetPageType="{x:Type local:SkinPage}" Icon="{ui:SymbolIcon Person24}" />
            </ui:NavigationView.MenuItems>
            <ui:NavigationView.PaneFooter>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    
                    <ui:Button Grid.Column="1" Command="{Binding ViewModel.OpenUpdateUrlCommand}" ToolTip="Update available" Appearance="Primary" Visibility="{Binding ViewModel.HasUpdate, Converter={StaticResource BooleanToVisibilityConverter}}" Margin="0,0,8,0" Width="36" Height="36" Padding="0">
                        <ui:SymbolIcon Symbol="ArrowDownload24" />
                    </ui:Button>
                    <ui:Button Grid.Column="1" ToolTip="Up to date" Appearance="Transparent" Visibility="{Binding ViewModel.HasUpdate, Converter={StaticResource InverseBooleanToVisibilityConverter}}" Margin="0,0,8,0" Width="36" Height="36" Padding="0" Foreground="{DynamicResource TextFillColorDisabledBrush}" IsEnabled="False">
                        <ui:SymbolIcon Symbol="ArrowDownload24" />
                    </ui:Button>

                    <ui:Button Grid.Column="2" Command="{Binding ViewModel.LoginCommand}" Appearance="Transparent" Margin="0,0,8,0" Padding="8,4">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="{Binding ViewModel.Username}" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <Image Source="{Binding ViewModel.AvatarUrl}" Width="24" Height="24">
                                <Image.Clip>
                                    <EllipseGeometry RadiusX="12" RadiusY="12" Center="12,12" />
                                </Image.Clip>
                            </Image>
                        </StackPanel>
                    </ui:Button>
                </Grid>
            </ui:NavigationView.PaneFooter>
            <ui:NavigationView.FooterMenuItems>
                <ui:NavigationViewItem Content="{DynamicResource Str_Settings}" TargetPageType="{x:Type local:SettingsPage}" Icon="{ui:SymbolIcon Settings24}" />
            </ui:NavigationView.FooterMenuItems>
        </ui:NavigationView>
        
        <ui:SnackbarPresenter x:Name="SnackbarPresenter" Grid.Row="0" />
    </Grid>
</ui:FluentWindow>
